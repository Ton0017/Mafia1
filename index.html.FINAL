  <script src="js/data/quests.js"></script>
  <script src="js/data/events.js"></script>
  <script src="js/data/drugs.js"></script>
  <script src="js/data/wounds.js"></script>
  <script src="js/data/sprites.js"></script>
  <script src="js/data/perks.js"></script>
  <script src="js/data/bar_scenes.js"></script>
  <script src="js/data/zone_scenes.js"></script>
  <script src="js/data/dialogues.js?v=27"></script>

  <script src="js/data/idle_events.js"></script>
