  <script src="js/systems/worldgen.js"></script>
  <script src="js/systems/diseases.js?v=23"></script>
  <script src="js/systems/time.js?v=26"></script>
  <script src="js/systems/economy.js"></script>
  <script src="js/systems/survival.js"></script>
  <script src="js/systems/sanity.js"></script>
  <script src="js/systems/drugs.js"></script>
  <script src="js/systems/wounds.js?v=26"></script>
  <script src="js/systems/combat.js?v=52"></script>
  <script src="js/systems/quests.js"></script>
  <script src="js/systems/hire.js"></script>
  <script src="js/systems/building.js"></script>
  <script src="js/systems/faction.js"></script>
  <script src="js/systems/events.js"></script>
  <script src="js/systems/zones.js"></script>
  <script src="js/systems/perks.js"></script>
  <script src="js/systems/bar_scenes.js"></script>
