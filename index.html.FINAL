  <title>City of Noir</title>
  <link rel="stylesheet" href="css/style.css">
</head>
<body>
  <div id="topbar">
    <div class="stat" id="stat-money">$ 0</div>
    <div class="stat" id="stat-rep">REP 0</div>
    <div class="stat" id="stat-heat">HEAT 0</div>
    <button id="audio-btn" onclick="Music.toggle()" title="Звук">♪</button>
    <div class="stat" id="stat-time">День 1, 08:00</div>
  </div>
  <main id="screen"></main>
  <aside id="log"></aside>

  <script src="js/utils.js"></script>
  <script src="js/state.js?v=22"></script>
  <script src="js/save.js"></script>
  <script src="js/engine.js?v=59"></script>

